<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Developer Registration | Identity Provider</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #f3f4f6;
      color: #1f2937;
      margin: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 2rem 0;
    }
    .login-card {
      background: white;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      padding: 2.5rem;
      width: 100%;
      max-width: 400px;
    }
    .header {
      text-align: center;
      margin-bottom: 2rem;
    }
    h1 { margin: 0; font-size: 1.5rem; }
    p.subtitle { color: #6b7280; margin-top: 0.5rem; }
    .form-group { margin-bottom: 1.25rem; }
    label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      font-size: 0.875rem;
    }
    input[type="text"], input[type="email"], input[type="password"] {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      box-sizing: border-box;
      font-size: 1rem;
    }
    .btn {
      width: 100%;
      background: #4f46e5;
      color: white;
      border: none;
      padding: 0.75rem;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 500;
      font-size: 1rem;
      margin-top: 1rem;
    }
    .btn:hover { background: #4338ca; }
    .error-msg {
      background: #fee2e2;
      color: #b91c1c;
      padding: 0.75rem;
      border-radius: 6px;
      margin-bottom: 1rem;
      font-size: 0.875rem;
    }
    .flex-row {
      display: flex;
      gap: 1rem;
    }
    .flex-1 {
      flex: 1;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="header">
      <h1>Register Account</h1>
      <p class="subtitle">Create an account to manage OAuth applications</p>
    </div>

    <% if (error) { %>
      <div class="error-msg"><%= error %></div>
    <% } %>

    <form action="/dashboard/register" method="POST">
      <div class="flex-row">
        <div class="form-group flex-1">
          <label for="firstName">First Name</label>
          <input type="text" id="firstName" name="firstName" required>
        </div>
        <div class="form-group flex-1">
          <label for="lastName">Last Name</label>
          <input type="text" id="lastName" name="lastName" required>
        </div>
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      
      <button type="submit" class="btn">Create Account</button>
    </form>
    
    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.875rem;">
      <p style="color: #6b7280;">Already have an account? <a href="/dashboard/login" style="color: #4f46e5; text-decoration: none; font-weight: 500;">Sign in here</a></p>
    </div>
  </div>
</body>
</html>
